<resources>
    <style name="Theme.Growdial" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
    <!-- the logo on the brand colour while the app starts, then the normal theme -->
    <style name="Theme.Growdial.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_anim</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Growdial</item>
    </style>
</resources>
